#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
NODE=${ROUTER_NODE:-/Applications/DeepSeek Harness.app/Contents/Resources/runtime/primary-runtime/dependencies/node/bin/node}
"$NODE" "$ROOT/plugin/node_modules/typescript/bin/tsc" -p "$ROOT/plugin/tsconfig.build.json"
"$NODE" "$ROOT/plugin/node_modules/typescript/bin/tsc" -p "$ROOT/plugin/tsconfig.json" --noEmit
NAPI_RS_FORCE_WASI=true "$NODE" "$ROOT/plugin/node_modules/vitest/vitest.mjs" run --root "$ROOT/plugin"
