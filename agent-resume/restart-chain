#!/bin/sh
# Restart the Reprise dependency chain: GUI + Quick Entry server (+ optional
# relaunch of the linked app). Explicit and reversible: it only stops/starts
# what it owns, and reports the resulting state. Never force-quits a linked app.
#
# Usage:
#   ./restart-chain              rebuild + restart Quick Entry server + GUI
#   ./restart-chain --no-build   restart without recompiling
#   ./restart-chain --server     only the Quick Entry server (no GUI relaunch)
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
APP="$ROOT/Reprise.app"
SOCKET="$HOME/.claude-desktop/quick-entry.sock"
STATE="${AGENT_RESUME_STATE:-$ROOT/quick-state}"
PYTHON=$(command -v python3)

build=1
gui=1
for arg in "$@"; do
    case "$arg" in
        --no-build) build=0 ;;
        --server)   gui=0 ;;
    esac
done

echo "1/6 · Nettoyage du socket Quick Apply orphelin"
rm -f "$SOCKET" 2>/dev/null || echo "   (socket non supprimable ici — ignoré)"

echo "2/6 · Arrêt d'une éventuelle instance du daemon Quick Apply"
pkill -f "claude_desktop_quick.py" 2>/dev/null || true

if [ "$build" = "1" ]; then
    echo "3/6 · Recompilation de Reprise"
    sh "$ROOT/native-install"
else
    echo "3/6 · Recompilation ignorée (--no-build)"
fi

echo "4/6 · Démarrage du daemon Quick Apply"
"$PYTHON" "$ROOT/resume" quick-apply-daemon-stop >/dev/null 2>&1 || true
"$PYTHON" "$ROOT/resume" quick-apply-daemon-start >/dev/null 2>&1 || echo "   (daemon Quick Apply non démarré ici — voir quick-apply-daemon-status)"

echo "5/6 · Redémarrage du daemon Codex (si l'exécutable Codex est présent)"
CODEX=$( "$PYTHON" -c "import sys; sys.path.insert(0,'$ROOT'); import engines; print(engines.executable('codex-cli') or '')" 2>/dev/null || true )
if [ -n "$CODEX" ]; then
    "$CODEX" app-server daemon stop >/dev/null 2>&1 || true
    "$CODEX" app-server daemon start -c 'forced_login_method="chatgpt"' >/dev/null 2>&1 || echo "   (daemon Codex non démarré ici — ignoré)"
else
    echo "   (exécutable Codex absent — ignoré)"
fi

if [ "$gui" = "1" ]; then
    echo "6/6 · Relance de l'application Reprise"
    open -n -a "$APP" --args "$ROOT" "$PYTHON"
else
    echo "6/6 · Application non relancée (--server)"
fi

echo "État :"
"$PYTHON" "$ROOT/resume" desktop-status 2>/dev/null || true
