#!/usr/bin/env python3
import argparse
import datetime as dt
import fcntl
import json
import os
from pathlib import Path
import plistlib
import shutil
import sqlite3
import subprocess
import sys
import uuid
import zipfile
import scheduler
import run_status
import engines
from runtime import codex_environment

ROOT = Path(__file__).resolve().parent
STATE = Path(os.environ.get('AGENT_RESUME_STATE', ROOT / 'state'))
LABEL = 'local.agent-resume'

def database():
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    db = sqlite3.connect(STATE / 'tasks.sqlite')
    db.row_factory = sqlite3.Row
    db.execute('CREATE TABLE IF NOT EXISTS tasks (id TEXT PRIMARY KEY, session TEXT, cwd TEXT, prompt TEXT, due REAL, status TEXT, attempts INTEGER DEFAULT 0)')
    scheduler.setup(db)
    run_status.setup(db)
    engines.setup(db)
    return db

def command(task, executable, automatic=False):
    return engines.command('codex-cli', task, executable, automatic=automatic)

def codex_executable():
    return engines.executable('codex-cli')

def run_due(db, executable):
    with (STATE / 'worker.lock').open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        # The lock proves no scheduler worker still owns these interrupted runs.
        with db:
            for stale in db.execute("SELECT id FROM tasks WHERE status='running'").fetchall():
                run_status.save(db, stale['id'], 'needs_review', 'Le worker s’est arrêté sans enregistrer de résultat final.', ended_at=dt.datetime.now().timestamp())
            db.execute("UPDATE tasks SET status='needs_review' WHERE status='running'")
        for task in db.execute("SELECT * FROM tasks WHERE status='ready' AND due<=? ORDER BY due", (dt.datetime.now().timestamp(),)).fetchall():
            automatic = db.execute('SELECT 1 FROM automation_events WHERE task_id=?', (task['id'],)).fetchone() is not None
            try:
                engine, settings = engines.route(db, task['id'])
                selected = engines.select(engine, settings)
                program = (executable if selected.startswith('codex') else None) or engines.executable(selected)
                if not program:
                    raise engines.Unavailable('engine_unavailable', 'Exécutable du moteur absent ; aucune substitution.')
                argv = None if selected in ('codex-server', 'codex-parent') else engines.command(selected, task, program, settings, automatic)
                if not scheduler.preflight(db, task, program):
                    continue
            except engines.Unavailable as error:
                run_status.save(db, task['id'], error.state, error.reason)
                with db:
                    db.execute("UPDATE tasks SET status='needs_review' WHERE id=?", (task['id'],))
                continue
            except Exception as error:
                with db:
                    scheduler.put(db, 'last_error', 'Préparation de reprise indisponible : ' + type(error).__name__)
                continue
            if not Path(task['cwd']).is_dir():
                db.execute("UPDATE tasks SET status='needs_path' WHERE id=?", (task['id'],)); db.commit(); continue
            with db:
                db.execute('BEGIN IMMEDIATE')
                current = db.execute('SELECT status,attempts FROM tasks WHERE id=?', (task['id'],)).fetchone()
                if not current or current['status'] != 'ready':
                    continue
                if automatic:
                    if not scheduler.enabled(db) or current['attempts']:
                        continue
                    consumed = db.execute('UPDATE automation_events SET consumed=1 WHERE task_id=? AND consumed=0', (task['id'],))
                    if not consumed.rowcount:
                        continue
                db.execute("UPDATE tasks SET status='running', attempts=attempts+1 WHERE id=?", (task['id'],))
            log = STATE / (task['id'] + '.log')
            try:
                if selected in ('codex-server', 'codex-parent'):
                    if selected == 'codex-parent':
                        from owner_route import execute
                    else:
                        from codex_rpc import execute
                    status = execute(db, task, program, settings, log, automatic)
                else:
                    environment = codex_environment() if selected == 'codex-cli' else dict(os.environ)
                    status = run_status.execute(db, task, argv, environment, log, engine=selected)
            except (OSError, subprocess.TimeoutExpired) as error:
                status = 'needs_review'
                run_status.save(db, task['id'], 'failed', 'Impossible de lancer le CLI : ' + type(error).__name__, ended_at=dt.datetime.now().timestamp())
            db.execute('UPDATE tasks SET status=? WHERE id=?', (status, task['id'])); db.commit()

def main():
    os.umask(0o077)
    parser = argparse.ArgumentParser(description='Reprise explicite par moteur, sans LLM pour le scheduler.')
    sub = parser.add_subparsers(dest='action', required=True)
    sub.add_parser('search').add_argument('query')
    add = sub.add_parser('add')
    add.add_argument('--session', required=True)
    add.add_argument('--engine', choices=engines.ENGINES, default='codex')
    add.add_argument('--profile')
    add.add_argument('--socket')
    add.add_argument('--parent')
    add.add_argument('--cwd', required=True)
    add.add_argument('--at', required=True, help='ISO 8601 avec fuseau, ex. 2026-10-14T18:00:00+02:00')
    add.add_argument('--prompt-file', required=True)
    for name in ('status', 'scheduler-status', 'connection-status', 'tick', 'install', 'uninstall', 'share', 'dashboard', 'detect', 'analyze', 'clear-index', 'engines'):
        sub.add_parser(name)
    config = sub.add_parser('engine-config')
    config.add_argument('engine', choices=engines.ENGINES)
    config.add_argument('--profile')
    config.add_argument('--socket')
    config.add_argument('--parent')
    check = sub.add_parser('server-check')
    check.add_argument('--socket')
    check.add_argument('--session')
    connection_config = sub.add_parser('connection-config')
    transport = connection_config.add_mutually_exclusive_group(required=True)
    transport.add_argument('--socket')
    transport.add_argument('--auto', action='store_true')
    desktop_check = sub.add_parser('desktop-server-check')
    desktop_check.add_argument('--socket')
    desktop_check.add_argument('--session')
    sub.add_parser('desktop-connection-status')
    sub.add_parser('reprise-health')
    sub.add_parser('reprise-resume')
    history = sub.add_parser('reprise-history')
    history.add_argument('--limit', type=int, default=20)
    desktop_config = sub.add_parser('desktop-connection-config')
    desktop_transport = desktop_config.add_mutually_exclusive_group(required=True)
    desktop_transport.add_argument('--socket')
    desktop_transport.add_argument('--auto', action='store_true')
    shared = sub.add_parser('shared-mode')
    shared.add_argument('operation', choices=('prepare', 'launch', 'check', 'stop'))
    shared.add_argument('--session')
    shared.add_argument('--startup', action='store_true')
    server = sub.add_parser('expert-server')
    server.add_argument('--socket', required=True)
    sub.add_parser('auto-mode').add_argument('mode', choices=('on', 'off'))
    for name in ('pause', 'enable'):
        sub.add_parser(name).add_argument('id')
    for name in ('backup', 'restore'):
        sub.add_parser(name).add_argument('archive')
    args = parser.parse_args()
    db = database()
    executable = codex_executable()
    if args.action == 'add':
        args.session = engines.validate_session(args.engine, args.session)
        settings = engines.options(args.engine, {k: getattr(args, k) for k in ('profile', 'socket', 'parent') if getattr(args, k) is not None})
        when = dt.datetime.fromisoformat(args.at)
        if when.tzinfo is None:
            parser.error('--at exige un fuseau horaire')
        cwd = Path(args.cwd).expanduser().resolve(strict=True)
        if not cwd.is_dir():
            parser.error('--cwd doit être un dossier')
        ident = str(uuid.uuid4())
        db.execute('INSERT INTO tasks VALUES (?,?,?,?,?,?,0)', (ident, args.session, str(cwd), Path(args.prompt_file).read_text(), when.timestamp(), 'paused'))
        engines.assign(db, ident, args.engine, settings)
        db.commit(); print(f'{ident} — en pause ; activer avec ./resume enable {ident}')
    elif args.action == 'engines':
        print(json.dumps(engines.capabilities(db), ensure_ascii=False))
    elif args.action == 'server-check':
        from connection import probe
        print(json.dumps(probe(executable, args.socket or str(engines.SOCKET), args.session), ensure_ascii=False))
    elif args.action == 'connection-status':
        from connection import status
        print(json.dumps(status(db, STATE), ensure_ascii=False))
    elif args.action == 'connection-config':
        from connection import configure
        print(json.dumps(configure(db, executable, args.socket), ensure_ascii=False))
    elif args.action == 'desktop-server-check':
        from claude_desktop import probe
        print(json.dumps(probe(executable, args.socket or str(Path.home()/'.claude-desktop/quick-entry.sock'), args.session), ensure_ascii=False))
    elif args.action == 'reprise-health':
        import reprise_health
        print(json.dumps(reprise_health.check('.'), ensure_ascii=False))
    elif args.action == 'reprise-resume':
        import reprise_logs
        print(json.dumps({'resumable': reprise_logs.resumable()}, ensure_ascii=False))
    elif args.action == 'reprise-history':
        import reprise_logs
        print(json.dumps(reprise_logs.history(limit=args.limit), ensure_ascii=False))
    elif args.action == 'desktop-connection-status':
        from claude_desktop import status
        print(json.dumps(status(db, STATE), ensure_ascii=False))
    elif args.action == 'desktop-connection-config':
        from claude_desktop import configure
        print(json.dumps(configure(db, executable, args.socket), ensure_ascii=False))
    elif args.action == 'shared-mode':
        import shared_mode
        if args.operation == 'check':
            if not args.session:
                parser.error('--session requis')
            result = shared_mode.check(db, executable, engines.validate_session('codex-cli', args.session))
        else:
            result = getattr(shared_mode, args.operation)(db, executable, STATE, args.startup)
        print(json.dumps(result, ensure_ascii=False))
    elif args.action == 'expert-server':
        import stat
        path = Path(args.socket)
        if not path.is_absolute() or not executable:
            parser.error('Chemin absolu et exécutable Codex requis')
        path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        info = path.parent.stat()
        if info.st_uid != os.getuid() or not stat.S_ISDIR(info.st_mode) or info.st_mode & 0o077:
            parser.error('Le dossier de socket doit appartenir à cet utilisateur et être privé (0700)')
        if path.exists() or path.is_symlink():
            parser.error('Socket déjà présent ; aucun propriétaire remplacé ni lien supprimé')
        argv = [executable, 'app-server', '-c', 'forced_login_method="chatgpt"', '-c', 'model_provider="openai"',
                '--listen', 'unix://' + str(path)]
        for feature in ('apps', 'plugins', 'hooks', 'browser_use', 'browser_use_external', 'computer_use', 'multi_agent', 'multi_agent_v2'):
            argv.extend(['--disable', feature])
        print('Serveur d’expertise au premier plan ; aucun rattachement aux sessions Desktop.', flush=True)
        subprocess.run(argv, env=codex_environment(), check=True)
    elif args.action == 'engine-config':
        settings = engines.options(args.engine, {k: getattr(args, k) for k in ('profile', 'socket', 'parent') if getattr(args, k) is not None})
        if not settings:
            parser.error('Fournir --socket ou --profile pour ce moteur')
        with db:
            db.execute('INSERT OR REPLACE INTO engine_settings VALUES (?,?)', (args.engine, json.dumps(settings)))
        print(json.dumps({'engine': args.engine, 'options': settings}))
    elif args.action == 'scheduler-status':
        print(json.dumps(scheduler.status(db, STATE) | {
            'installed': (Path.home() / 'Library/LaunchAgents' / (LABEL + '.plist')).exists(),
            'executable_available': any(item['available'] for item in engines.capabilities(db)), 'engines': engines.capabilities(db)}, ensure_ascii=False))
    elif args.action == 'auto-mode':
        with db:
            scheduler.put(db, 'auto_enabled', args.mode == 'on')
            shared = scheduler.get(db, 'shared_mode', {})
            if shared.get('restore_auto_after_check'):
                scheduler.put(db, 'shared_mode', shared | {'restore_auto_after_check': False})
        print(json.dumps({'auto_enabled': scheduler.enabled(db)}))
    elif args.action == 'status':
        for row in engines.decorate(db, run_status.rows(db, STATE)):
            print(json.dumps({k: row[k] for k in ('id', 'session', 'cwd', 'status', 'attempts', 'label', 'engine', 'provider')} | {'at': dt.datetime.fromtimestamp(row['due']).astimezone().isoformat()}, ensure_ascii=False))
    elif args.action in ('pause', 'enable'):
        row = db.execute('SELECT * FROM tasks WHERE id=?', (args.id,)).fetchone()
        if not row or row['status'] == 'running':
            parser.error('Tâche absente ou actuellement en cours')
        event = db.execute('SELECT consumed FROM automation_events WHERE task_id=?', (args.id,)).fetchone()
        if args.action == 'enable' and event and (event['consumed'] or row['attempts'] or row['status'] == 'cancelled'):
            parser.error('Interruption automatique déjà traitée ou périmée ; aucune seconde tentative automatique')
        if args.action == 'enable' and not Path(row['cwd']).is_dir():
            parser.error('Dossier indisponible')
        db.execute('UPDATE tasks SET status=? WHERE id=?', ('ready' if args.action == 'enable' else 'paused', args.id)); db.commit()
    elif args.action == 'clear-index':
        from private_search import cleanup
        print(json.dumps({'removed': cleanup(STATE, clear=True)}))
    elif args.action == 'search':
        from private_search import search
        print(json.dumps(search(STATE, ROOT, args.query[:500]), ensure_ascii=False))
    elif args.action == 'analyze':
        from local_analysis import analyze
        analyze(STATE)
    elif args.action == 'detect':
        from detect import scan_all
        print(json.dumps(scan_all(), ensure_ascii=False))
    elif args.action == 'dashboard':
        from dashboard import serve
        serve(database, ROOT)
    elif args.action == 'tick':
        from private_search import cleanup
        with db:
            scheduler.put(db, 'last_tick', dt.datetime.now().timestamp())
            scheduler.put(db, 'last_error', None)
        if executable:
            try:
                scheduler.reconcile(db, scheduler.snapshot())
                scheduler.refresh_waiting(db, executable)
            except Exception as error:
                with db:
                    scheduler.put(db, 'last_error', 'Détection automatique indisponible : ' + type(error).__name__)
        run_due(db, executable)
        try:
            cleanup(STATE)
        except (ValueError, OSError, sqlite3.Error):
            pass
    elif args.action == 'backup':
        from task_archive import backup
        backup(db, args.archive)
        print(args.archive)
    elif args.action == 'restore':
        from task_archive import restore
        restore(db, args.archive)
        print('Tâches importées en pause ; les identifiants déjà présents restent inchangés.')
    elif args.action == 'share':
        dest = Path.cwd() / 'agent-resume-share.zip'
        with zipfile.ZipFile(dest, 'w', zipfile.ZIP_DEFLATED) as archive:
            for name in ('resume', 'VERSION', 'scheduler.py', 'presentation.py', 'connection.py', 'shared_mode.py', 'ROADMAP.md', 'quota.py', 'run_status.py', 'runtime.py', 'engines.py', 'engine_events.py', 'codex_rpc.py', 'owner_route.py', 'task_archive.py', 'codex_expert.py', 'claude_expert.py', 'codex_expert_mcp.py', 'install-expertise.py', 'reprise-delegation.md', 'CODEX-INTEGRATION.md', 'CLAUDE-INTEGRATION.md', 'CACHE-POLICY.md', 'README.md', 'prompt.example.txt', 'dashboard.py', 'dashboard.html', 'detect.py', 'Native.swift', 'Dashboard.swift', 'native-install', 'harness-events.cjs', 'local_analysis.py', 'verdict-schema.json', 'Embedding.swift', 'private_search.py', 'Vault.swift', 'vault.py'):
                archive.write(ROOT / name, 'agent-resume/' + name)
        print(dest)
    elif args.action in ('install', 'uninstall'):
        if sys.platform != 'darwin':
            parser.error('Installation du service disponible sur macOS seulement')
        plist = Path.home() / 'Library/LaunchAgents' / (LABEL + '.plist')
        target = f'gui/{os.getuid()}'
        if args.action == 'uninstall':
            subprocess.run(['launchctl', 'bootout', target + '/' + LABEL], capture_output=True)
            plist.unlink(missing_ok=True)
        else:
            if not any(item['available'] for item in engines.capabilities(db)):
                parser.error('Installer et configurer au moins un moteur pris en charge')
            if plist.exists():
                parser.error('Service déjà installé ; désinstaller avant de réinstaller')
            plist.parent.mkdir(parents=True, exist_ok=True)
            settings = {'Label': LABEL, 'ProgramArguments': [sys.executable, str(ROOT / 'resume'), 'tick'], 'StartInterval': 60, 'EnvironmentVariables': {'AGENT_RESUME_STATE': str(STATE), 'PATH': ':'.join(sorted({str(Path(p).parent) for key in engines.ENGINES if (p := engines.executable(key))})) + ':/usr/bin:/bin'}, 'StandardOutPath': str(STATE / 'service.log'), 'StandardErrorPath': str(STATE / 'service-error.log')}
            plist.write_bytes(plistlib.dumps(settings))
            result = subprocess.run(['launchctl', 'bootstrap', target, str(plist)], capture_output=True, text=True)
            if result.returncode:
                plist.unlink(); parser.error(result.stderr)
            print('Service installé ; reprise automatique des interruptions de quota confirmées selon le mode enregistré.')
    db.close()

if __name__ == '__main__':
    main()
