#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
APP="$ROOT/Reprise.app"
VERSION=$(cat "$ROOT/VERSION")
OPEN=0
RUNTIME_ARCHIVE=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --open) OPEN=1; shift ;;
        --runtime-archive)
            [ "$#" -ge 2 ] || { echo "--runtime-archive exige un chemin" >&2; exit 2; }
            RUNTIME_ARCHIVE=$2; shift 2 ;;
        *) echo "Usage: $0 [--runtime-archive FILE] [--open]" >&2; exit 2 ;;
    esac
done
SDK_VERSION=$(xcrun --sdk macosx --show-sdk-version)
python3 "$ROOT/native_contract.py" --check-sdk "$SDK_VERSION"
TARGET="$(uname -m)-apple-macosx26.0"
if [ -n "$RUNTIME_ARCHIVE" ]; then
    python3 "$ROOT/package_runtime.py" --archive "$RUNTIME_ARCHIVE" --app "$APP"
fi
python3 "$ROOT/package_helpers.py" "$ROOT" "$APP"
mkdir -p "$APP/Contents/MacOS"
swiftc -target "$TARGET" -module-cache-path /private/tmp/agent-resume-swift-cache "$ROOT/Native.swift" "$ROOT/Dashboard.swift" "$ROOT/StateSetup.swift" "$ROOT/Integrations.swift" "$ROOT/SchedulerService.swift" "$ROOT/IronClawConnection.swift" -o "$APP/Contents/MacOS/Reprise"
swiftc -target "$TARGET" -module-cache-path /private/tmp/agent-resume-swift-cache "$ROOT/Embedding.swift" -o "$APP/Contents/MacOS/Embedding"
swiftc -target "$TARGET" -module-cache-path /private/tmp/agent-resume-swift-cache "$ROOT/FoundationExplain.swift" -o "$APP/Contents/MacOS/FoundationExplain"
swiftc -target "$TARGET" -module-cache-path /private/tmp/agent-resume-swift-cache "$ROOT/Vault.swift" -o "$APP/Contents/MacOS/Vault"
swiftc -target "$TARGET" -module-cache-path /private/tmp/agent-resume-swift-cache "$ROOT/ClaudeQuota.swift" -o "$APP/Contents/MacOS/ClaudeQuota"
# A persistent certificate and identifier preserve the helper's signing identity.
# Ad-hoc development builds cannot promise Keychain trust across rebuilds.
if [ -n "${REPRISE_SIGNING_IDENTITY:-}" ]; then
    codesign --force --sign "$REPRISE_SIGNING_IDENTITY" --identifier local.agent-resume.vault "$APP/Contents/MacOS/Vault"
    codesign --verify --strict "$APP/Contents/MacOS/Vault"
fi
cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd"><plist version="1.0"><dict><key>CFBundleExecutable</key><string>Reprise</string><key>CFBundleIdentifier</key><string>local.agent-resume.native</string><key>CFBundleName</key><string>Reprise</string><key>CFBundleShortVersionString</key><string>$VERSION</string><key>CFBundleVersion</key><string>$VERSION</string><key>LSMinimumSystemVersion</key><string>26.0</string><key>LSUIElement</key><true/></dict></plist>
PLIST
python3 "$ROOT/native_contract.py" "$APP"
# Launch only when explicitly requested: a plain run just rebuilds.
# Compiling should not disturb an already-running instance.
if [ "$OPEN" = 1 ]; then
    open -n -a "$APP" --args "$ROOT" "$(command -v python3)"
fi
